# Copy this file to ".env" and fill in SECRET_KEY before running NexiVault.
# NEVER share or upload your real .env file.

# REQUIRED - a long random value. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# Optional settings (defaults shown)
AUTO_LOCK_MINUTES=15        # lock the vault after this many idle minutes
SESSION_MAX_HOURS=8         # force a fresh sign-in after this many hours
MAX_LOGIN_ATTEMPTS=5        # failed sign-ins allowed before a temporary lockout
LOGIN_LOCK_MINUTES=10       # how long the lockout lasts
COOKIE_SECURE=0             # set to 1 only when serving over HTTPS
FLASK_DEBUG=0               # keep 0 unless you are actively debugging
